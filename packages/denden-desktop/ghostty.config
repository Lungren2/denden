# Den Den's settings for Ghostty, the terminal. Your
# ~/.config/ghostty/config.ghostty includes this file and then your own
# config.local, so anything you set in config.local wins. Colours come from
# Noctalia (the `theme = noctalia` line it keeps in config.ghostty).
# Reference: `ghostty +show-config --default --docs`

# fish, with suggestions from your history, a Tab menu and syntax
# highlighting. It starts through a bash login shell, so it has the same
# environment (PATH, mise's shims, /etc/profile.d) as everything else.
command = /usr/bin/bash --login -c "exec /usr/bin/fish"
shell-integration = fish

# Type: Cascadia Code, the font of Windows Terminal.
font-family = Cascadia Code
font-size = 11
adjust-cell-height = 10%

# The window: room around the text, a slightly translucent background the
# compositor blurs, and no tab bar until there is a second tab.
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.94
background-blur = true
window-decoration = none
gtk-tabs-location = top
gtk-wide-tabs = false
resize-overlay = never
window-inherit-working-directory = true

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = true

# Keys as in Windows Terminal: Ctrl+C copies when text is selected (and
# interrupts otherwise), Ctrl+V pastes, Ctrl+Shift+T opens a tab,
# Alt+Shift+Plus and Alt+Shift+Minus split, Alt+arrows move between splits
# (only when there are splits; otherwise they reach the shell).
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = alt+shift+equal=new_split:right
keybind = alt+shift+plus=new_split:right
keybind = alt+shift+minus=new_split:down
keybind = performable:alt+left=goto_split:left
keybind = performable:alt+right=goto_split:right
keybind = performable:alt+up=goto_split:up
keybind = performable:alt+down=goto_split:down
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
