# Maintainer: Ethan <ethanogle012@outlook.com>
#
# The Den Den desktop: a Niri session where T3 Code is the main window. At
# login T3 Code opens maximized above a taskbar drawn by Noctalia, which also
# provides the launcher, quick settings, notifications, wallpaper and lock
# screen. Other windows open as columns beside T3 Code. The installer enables
# greetd and logs the user in straight into this session.
#
# GPU drivers aren't listed here: the installer adds them for the hardware it
# finds.

pkgname=denden-desktop
pkgver=0.1.0
pkgrel=3
pkgdesc='Den Den desktop: a Niri session with T3 Code as the main window'
arch=('any')
url='https://github.com/Lungren2/denden'
license=('MIT')
depends=(
  'denden-base' 't3code-desktop'
  # Session
  'niri' 'xwayland-satellite' 'greetd'
  'xdg-desktop-portal-gnome' 'xdg-desktop-portal-gtk'
  # The shell: taskbar, launcher, quick settings, notifications, wallpaper,
  # lock screen and password prompts
  'noctalia'
  # Apps the taskbar pins, the clipboard, and the Secret Service T3 Code
  # keeps credentials in
  'foot' 'nautilus' 'wl-clipboard' 'gnome-keyring'
  # GTK apps in the dark theme
  'adw-gtk-theme' 'dconf'
  # Audio, and the microphone T3 Code's voice input uses
  'pipewire' 'pipewire-pulse' 'pipewire-alsa' 'wireplumber'
  # The browser, which sign-ins from agents and CLIs open in too. Prebuilt
  # from CachyOS for now; a source build is on the roadmap.
  'helium-browser-bin'
  'noto-fonts' 'noto-fonts-emoji'
  # Tools the user's projects need
  'godot' 'blender'
)
source=(
  'config.kdl'
  'denden-shell'
  'noctalia.toml'
  'DenDen.json'
  'mimeapps.list'
  'dconf-denden'
  'denden-github.desktop'
  '50-niri-limit-free-buffer-pool.json'
)
sha256sums=(
  '2be2ab4ee15e0f1e40aebd612f1ed7f0094725a3d7c22c4da43e738b9015cda7'
  '4ae16d96dc88229e05462da95aba6ee31ceae8b91cc6b163361a552ae0e8e084'
  '762d708cf97e502d4eccff7c4b4ce42ef4b953176a5c993bc7b9c5a431f8b120'
  'daba5531decf23aa3008a81ed9a1678443f146385f3064682de219adc004d7ae'
  '1be143020d6d0c0ad89c28e1c85a8fd045bb68568b5eb93cdb1824ff75f9c665'
  '4af02bb4a6365e718a30283d4c2fd11d124af6d8ecca48f695e4690e1e2e0beb'
  'd7264ecd5a448c88895e21a3d20e9b1b4015cec3123b8e330f77e1d31d640053'
  '1a04a9eb0e51c8eba4f06373c9e514012417f01295d4938ed0635932fb24cd47'
)

package() {
  # Niri's system-wide config; a user's ~/.config/niri/config.kdl replaces it.
  install -Dm644 config.kdl "${pkgdir}/etc/niri/config.kdl"

  # Noctalia with Den Den's settings and palette.
  install -Dm755 denden-shell "${pkgdir}/usr/bin/denden-shell"
  install -Dm644 noctalia.toml "${pkgdir}/usr/share/denden/noctalia/denden.toml"
  install -Dm644 DenDen.json "${pkgdir}/usr/share/denden/noctalia/DenDen.json"

  # A launcher entry to sign in to GitHub, after which denden-repos (from
  # denden-base) brings the user's repositories into ~/Projects.
  install -Dm644 denden-github.desktop "${pkgdir}/usr/share/applications/denden-github.desktop"

  # Helium opens web links and pages; Files opens folders.
  install -Dm644 mimeapps.list "${pkgdir}/etc/xdg/mimeapps.list"

  # Dark GTK apps, as a system dconf database (dconf's pacman hook compiles it).
  install -Dm644 dconf-denden "${pkgdir}/etc/dconf/db/local.d/00-denden"
  printf 'user-db:user\nsystem-db:local\n' | install -Dm644 /dev/stdin "${pkgdir}/etc/dconf/profile/user"

  # On NVIDIA, stop the driver from holding on to freed buffers in niri,
  # which otherwise grows its VRAM use to gigabytes. Inert on other GPUs.
  install -Dm644 50-niri-limit-free-buffer-pool.json \
    "${pkgdir}/etc/nvidia/nvidia-application-profiles-rc.d/50-niri-limit-free-buffer-pool.json"
}
