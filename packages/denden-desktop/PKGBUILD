build() {
  # The wallpaper, drawn at 1440p; Noctalia crops and scales it to the screen.
  python wallpaper.py 2560 1440 | magick ppm:- -depth 8 -define png:color-type=2 wallpaper.png
}

package() {
  # Niri's system-wide config; a user's ~/.config/niri/config.kdl replaces it.
  install -Dm644 config.kdl "${pkgdir}/etc/niri/config.kdl"

  # Noctalia with Den Den's settings and palette.
  install -Dm755 denden-shell "${pkgdir}/usr/bin/denden-shell"
  install -Dm644 noctalia.toml "${pkgdir}/usr/share/denden/noctalia/denden.toml"
  install -Dm644 DenDen.json "${pkgdir}/usr/share/denden/noctalia/DenDen.json"
  install -Dm644 wallpaper.png "${pkgdir}/usr/share/denden/wallpaper/denden.png"

  # The terminal. Ghostty's own user service keeps it running in the
  # background, so a new window (Super+Enter) opens at once.
  install -Dm644 ghostty.config "${pkgdir}/usr/share/denden/ghostty/config"
  install -Dm644 denden.fish "${pkgdir}/usr/share/fish/vendor_conf.d/denden.fish"
  install -Dm644 starship.toml "${pkgdir}/usr/share/denden/starship.toml"
  install -d "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../app-com.mitchellh.ghostty.service \
    "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants/app-com.mitchellh.ghostty.service"

  # A launcher entry to sign in to GitHub, after which denden-repos (from
  # denden-base) brings the user's repositories into ~/Projects.
  install -Dm644 denden-github.desktop "${pkgdir}/usr/share/applications/denden-github.desktop"

  # And one to put the machine on the user's Tailscale network.
  install -Dm644 denden-tailscale.desktop "${pkgdir}/usr/share/applications/denden-tailscale.desktop"

  # Backups: a launcher entry to set them up on the Den Den stick, and a
  # reminder when the last one is more than three days old.
  install -Dm644 denden-backup.desktop "${pkgdir}/usr/share/applications/denden-backup.desktop"
  install -Dm755 denden-backup-reminder "${pkgdir}/usr/bin/denden-backup-reminder"
  install -Dm644 -t "${pkgdir}/usr/lib/systemd/user" denden-backup-reminder.service denden-backup-reminder.timer
  install -d "${pkgdir}/usr/lib/systemd/user/timers.target.wants"
  ln -s ../denden-backup-reminder.timer "${pkgdir}/usr/lib/systemd/user/timers.target.wants/denden-backup-reminder.timer"

  # Helium opens web links and pages; Files opens folders.
  install -Dm644 mimeapps.list "${pkgdir}/etc/xdg/mimeapps.list"

  # Dark GTK apps, as a system dconf database (dconf's pacman hook compiles it).
  install -Dm644 dconf-denden "${pkgdir}/etc/dconf/db/local.d/00-denden"
  printf 'user-db:user\nsystem-db:local\n' | install -Dm644 /dev/stdin "${pkgdir}/etc/dconf/profile/user"

  # On NVIDIA, stop the driver from holding on to freed buffers in niri,
  # which otherwise grows its VRAM use to gigabytes. Inert on other GPUs.
  install -Dm644 50-niri-limit-free-buffer-pool.json \
    "${pkgdir}/etc/nvidia/nvidia-application-profiles-rc.d/50-niri-limit-free-buffer-pool.json"
}
