#!/usr/bin/env bash
# Start Noctalia, the desktop shell, with Den Den's look. Niri runs this at
# login.
#
# Noctalia only reads config from the user's own directory, so link Den Den's
# palette there and include Den Den's settings from the user's config.toml.
# The user's config and Noctalia's Settings still override them.
set -u

share=/usr/share/denden/noctalia
config="${XDG_CONFIG_HOME:-${HOME}/.config}/noctalia"

mkdir -p -- "${config}/palettes"
ln -sfn -- "${share}/DenDen.json" "${config}/palettes/DenDen.json"
if [[ ! -e ${config}/config.toml ]]; then
  cat > "${config}/config.toml" <<EOF
# Your Noctalia settings. Den Den's are included first, so anything set below
# replaces them. Reference: https://docs.noctalia.dev/noctalia/
[include]
files = ["${share}/denden.toml"]
EOF
fi

# The terminal, Ghostty, reads only the user's own config, so start one
# that includes Den Den's settings and then the user's config.local, which
# win. Noctalia adds the palette's `theme` line to it.
# Ghostty writes a template of comments on its first run; if it got there
# first (its service starts with the session too), replace that template.
ghostty_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/ghostty"
ghostty_config=${ghostty_dir}/config.ghostty
if [[ ! -e ${ghostty_dir}/config ]] && { [[ ! -e ${ghostty_config} ]] \
    || grep -q 'This template file has been automatically created' "${ghostty_config}"; }; then
  theme=$(grep -E '^theme *=' "${ghostty_config}" 2>/dev/null || true)
  mkdir -p -- "${ghostty_dir}"
  cat > "${ghostty_config}" <<'EOF'
# Ghostty, the terminal. This file includes Den Den's settings, then yours
# from config.local (next to this file), which win. Put your changes there:
# both files are read after this one, so a setting here is overridden.
# Reference: ghostty +show-config --default --docs
config-file = /usr/share/denden/ghostty/config
config-file = ?config.local
EOF
  [[ -n ${theme} ]] && printf '%s\n' "${theme}" >> "${ghostty_config}"
  systemctl --user reload app-com.mitchellh.ghostty.service 2>/dev/null || true
fi

exec noctalia "$@"
