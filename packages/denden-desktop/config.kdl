// Den Den desktop. T3 Code opens maximized at login above a taskbar
// (Noctalia): the Den Den mark opens the launcher, your apps sit beside it,
// status and the clock are on the right. Anything else you open becomes a
// column beside T3 Code; Mod+Home brings you back. Mod is the Super
// (Windows) key; Mod+Shift+Slash lists every shortcut.
//
// To customize, copy this file to ~/.config/niri/config.kdl and edit it.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

input {
    keyboard {
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
    // Leave the power button to logind, which powers off (niri would suspend).
    disable-power-key-handling
}

// greetd starts this session from a console login, so apps would otherwise
// see XDG_SESSION_TYPE=tty and Electron apps (T3 Code among them) would open
// through X11 instead of natively.
environment {
    XDG_SESSION_TYPE "wayland"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    // Noctalia draws the wallpaper behind the windows.
    background-color "transparent"
    focus-ring {
        off
    }
    border {
        off
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

spawn-at-startup "denden-shell"
spawn-at-startup "t3code"

window-rule {
    match app-id="^com\\.t3tools\\.T3Code$"
    open-maximized true
}

// Noctalia's Settings window floats over the desktop.
window-rule {
    match app-id="^dev\\.noctalia\\.Noctalia$"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 860; }
}

// The wallpaper also fills the background of the overview (Mod+O).
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Lets notification actions bring their app's window forward.
debug {
    honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Space hotkey-overlay-title="Open the launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Quick settings" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Return hotkey-overlay-title="Open a terminal" { spawn "foot"; }
    Mod+T hotkey-overlay-title="Open T3 Code" { spawn "t3code"; }
    Mod+B hotkey-overlay-title="Open Helium" { spawn "helium-browser"; }
    Mod+E hotkey-overlay-title="Open Files" { spawn "nautilus" "--new-window"; }
    Mod+Q { close-window; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Alt+Shift+Tab { spawn-sh "noctalia msg window-switcher hold reverse"; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }

    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+O repeat=false { toggle-overview; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+V { toggle-window-floating; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }

    Mod+Alt+L hotkey-overlay-title="Lock the screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
}
