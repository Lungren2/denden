// Den Den desktop. T3 Code is the desktop: it opens maximized at login, with
// no bar, gaps or borders. Anything else you open (a browser for a sign-in,
// Godot, Blender, a terminal) opens as a new column beside it; Mod+Home
// brings you back. Mod is the Super (Windows) key.
//
// To customize, copy this file to ~/.config/niri/config.kdl and edit it.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

input {
    keyboard {
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
    // Leave the power button to logind, which powers off (niri would suspend).
    disable-power-key-handling
}

// greetd starts this session from a console login, so apps would otherwise
// see XDG_SESSION_TYPE=tty and Electron apps (T3 Code among them) would open
// through X11 instead of natively.
environment {
    XDG_SESSION_TYPE "wayland"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 0
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        off
    }
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

spawn-at-startup "mako"
spawn-at-startup "t3code"

window-rule {
    match app-id="^com\\.t3tools\\.T3Code$"
    open-maximized true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a terminal" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Mod+T hotkey-overlay-title="Open T3 Code" { spawn "t3code"; }
    Mod+Q { close-window; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }

    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+O repeat=false { toggle-overview; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+V { toggle-window-floating; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
