#!/usr/bin/env bash
# Remind the user to plug in the Den Den stick when the last backup is more
# than three days old. Silent until backups are set up.
set -u

[[ -r /etc/denden/backup.conf ]] || exit 0
last=$(cat /var/lib/denden-backup/last-success 2>/dev/null || echo 0)
days=$(( ($(date +%s) - last) / 86400 ))
((days >= 3)) || exit 0

if ((last == 0)); then
  body="Nothing has been backed up yet. Plug in the Den Den USB stick to back up."
else
  body="The last backup was ${days} days ago. Plug in the Den Den USB stick to back up."
fi
notify-send --app-name=Backups --icon=drive-removable-media "Back up your files" "${body}"
