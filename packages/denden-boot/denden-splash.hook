# Plymouth's theme is built into the initramfs, so rebuild it (and Limine's
# copy) when the Den Den splash changes.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/plymouth/themes/denden/*

[Action]
Description = Updating the boot splash...
When = PostTransaction
Exec = /usr/bin/limine-mkinitcpio
