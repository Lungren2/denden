# Maintainer: Ethan <ethanogle012@outlook.com>
#
# What an installed Den Den system adds on top of `base`: the agents, the
# toolchains the user's projects need (with mise for per-project versions),
# snapshots, the user's GitHub repositories kept in ~/Projects (denden-repos),
# remote access over Tailscale behind a firewall, backups to the Den Den
# USB stick (denden-backup), and the system contract
# agents load (/etc/denden/AGENTS.md).

pkgname=denden-base
pkgver=0.1.0
pkgrel=6
pkgdesc='Den Den base system: agents, toolchains, snapshots and the agent contract'
arch=('any')
url='https://github.com/Lungren2/denden'
license=('MIT')
depends=(
  # Agents
  't3code-cli' 'claude-code' 'openai-codex'
  # Building any package on the system from source
  'base-devel' 'devtools' 'git' 'github-cli' 'expac'
  # Toolchains
  'nodejs' 'npm' 'pnpm' 'bun' 'rust' 'python' 'uv' 'dotnet-sdk'
  # Per-project tool versions (a project's mise.toml)
  'mise'
  # Containers
  'docker' 'docker-compose' 'docker-buildx'
  # Snapshots and sandboxing
  'btrfs-progs' 'snapper' 'snap-pac' 'bubblewrap'
  # Tools agents reach for
  'ripgrep' 'fd' 'jq' 'openssh' 'man-db' 'less'
  # Terminal tools
  'fzf' 'zoxide' 'lazygit' 'git-delta' 'btop' 'dust' 'duf' 'hyperfine'
  'go-yq' 'tmux'
  # Remote access, and a firewall that only lets it in
  'tailscale' 'nftables'
  # Backups
  'restic' 'gptfdisk' 'e2fsprogs'
)
source=(
  'AGENTS.md'
  'agents.tmpfiles'
  'denden-repos'
  'denden-repos.service'
  'denden-repos.timer'
  'profile.sh'
  'environment.conf'
  'gitconfig'
  'logind.conf'
  'firewall.nft'
  'denden-firewall.service'
  'denden-tailscale'
  'denden-backup'
  'denden-backup.service'
  'denden-backup.timer'
  'denden-backup.rules'
  'backup-excludes'
)
sha256sums=(
