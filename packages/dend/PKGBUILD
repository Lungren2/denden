prepare() {
  # makepkg links the sources into $srcdir; cargo builds them from there.
  export CARGO_HOME="${srcdir}/cargo"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  export CARGO_HOME="${srcdir}/cargo"
  # Crate paths in panic messages, without the build directory.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo build --frozen --release --target-dir "${srcdir}/target"
}

package() {
  install -Dm755 "${srcdir}/target/release/dend" "${pkgdir}/usr/lib/dend"
  install -Dm644 -t "${pkgdir}/usr/lib/systemd/system" dend.service dend.socket
  install -d "${pkgdir}/usr/lib/systemd/system/sockets.target.wants"
  ln -s ../dend.socket "${pkgdir}/usr/lib/systemd/system/sockets.target.wants/dend.socket"
  install -Dm644 -t "${pkgdir}/usr/share/varlink" io.denden.*.varlink
}
