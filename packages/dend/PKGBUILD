# Maintainer: Ethan <ethanogle012@outlook.com>
#
# dend, Den Den's machine API: a Varlink service on /run/den/io.denden that
# agents and people query for the machine's state (hardware, packages,
# services, history, health). `den machine|package|service|history|doctor`
# and the den MCP server are its clients; `varlinkctl introspect
# /run/den/io.denden` shows the interfaces. Read-only until the broker.

pkgname=dend
pkgver=0.1.0
pkgrel=1
pkgdesc="Den Den's machine API: hardware, packages, services, history and health for agents"
arch=('x86_64')
url='https://github.com/Lungren2/denden'
license=('MIT')
depends=('glibc' 'gcc-libs' 'systemd' 'pacman' 'expac' 'util-linux' 'pciutils'
         'smartmontools' 'snapper')
makedepends=('rust')
optdepends=('tailscale: the doctor reports whether the machine can be reached')
options=('!lto')
source=('Cargo.toml' 'Cargo.lock' 'main.rs' 'util.rs' 'machine.rs' 'doctor.rs'
        'package.rs' 'service.rs' 'history.rs'
        'org.varlink.service.varlink' 'io.denden.Machine.varlink'
        'io.denden.Package.varlink' 'io.denden.Service.varlink'
        'io.denden.History.varlink' 'dend.service' 'dend.socket')
